{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/w/wallet/:addr",
      "destination": "/api/share?addr=:addr"
    },
    {
      "source": "/w/wallet/:addr/:card",
      "destination": "/api/share?addr=:addr&card=:card"
    },
    {
      "source": "/w/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/w/:id/:card",
      "destination": "/api/share?id=:id&card=:card"
    },
    {
      "source": "/w/:path*",
      "destination": "/api/share"
    }
  ]
}